import math


def calculate_metrics(tp, fp, fn):
    precision = tp / (tp + fp)
    recall = tp / (tp + fn)
    f1_score = 2 * (precision * recall) / (precision + recall)
    return print(f"precision is {precision}.\n recall is {recall} \n f1 score is {f1_score}")
def evaluate_f1_components(tp,fp,fn):
    if type(tp) != int:
        print("tp must be int")
        return
    
    elif type(fp) != int:
        print("fn must be int")
        return
    elif type(fn) != int:
        print("fn must be int")
        return
    else:
        if tp < 0 or fp < 0 or fn < 0:
            print("tp and fp and fn must be greater than or equal zero")
            return
        else:
            calculate_metrics(tp, fp, fn)
        

evaluate_f1_components(tp=2, fp=3, fn=4)
evaluate_f1_components(tp="a", fp=3, fn=4)
evaluate_f1_components(tp=2, fp="a", fn=4)
